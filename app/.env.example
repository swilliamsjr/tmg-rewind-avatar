# ─────────────────────────────────────────────────────────────────────────────
# tmg-rewind-avatar — environment variables
#
# In Azure Container Apps these are set by the Bicep template from the
# Deploy-to-Azure parameters. For LOCAL development copy this file to
# `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Azure AI Foundry / AI Services endpoint that exposes Voice Live.
# Format: https://<resource>.cognitiveservices.azure.com/
AZURE_VOICELIVE_ENDPOINT="https://<your-foundry>.cognitiveservices.azure.com/"

# Realtime model deployment name. Accepted values include:
#   gpt-realtime                       (current GA model, recommended)
#   gpt-4o-mini-realtime               (current GA mini model)
#   gpt-4o-realtime-preview            (legacy preview)
#   gpt-4o-mini-realtime-preview       (legacy preview)
VOICELIVE_MODEL="gpt-realtime"

# Default TTS voice. See Microsoft Speech voices list for options.
VOICELIVE_VOICE="en-US-AvaMultilingualNeural"
VOICELIVE_VOICE_TYPE="standard"   # standard | custom | personal

# Default agent / system instructions presented to the realtime model.
# Multi-line is fine — wrap the whole value in quotes.
VOICELIVE_INSTRUCTIONS="You are MAX, a friendly content guide for a TV streaming service. Help the viewer find a movie or show for tonight. Keep replies short and conversational."

# Avatar configuration
VOICELIVE_AVATAR_ENABLED="true"
VOICELIVE_AVATAR_CHARACTER="lisa"
VOICELIVE_AVATAR_OUTPUT_MODE="webrtc"
VOICELIVE_IS_PHOTO_AVATAR="false"
VOICELIVE_IS_CUSTOM_AVATAR="false"

# Background image. Empty string falls back to the bundled static/background.png.
# When set, must be a publicly fetchable HTTPS URL (e.g. an Azure Storage blob
# in the deployed `backgrounds` container).
VOICELIVE_AVATAR_BG_URL=""

# Optional tuning
VOICELIVE_TURN_DETECTION=""
VOICELIVE_REMOVE_FILLER_WORDS=""
VOICELIVE_ENABLE_PROACTIVE=""
VOICELIVE_TEMPERATURE=""
VOICELIVE_VOICE_TEMPERATURE=""
VOICELIVE_VOICE_SPEED=""
VOICELIVE_USE_NS=""
VOICELIVE_USE_EC=""

# Telemetry — set automatically by Bicep from the deployed Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
